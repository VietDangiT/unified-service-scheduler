# Demo script against the one-command demo (docker compose up --build). Run the requests in order.
# Dealership Northgate (the NorthgateDemoSeed migration), open Monday to Friday 08:00-17:00:
#   Ben    General             08:00-17:00
#   Chloe  General, EV         08:00-17:00
#   Dan    General, Alignment  12:00-17:00
#   Bays   Bay-A, Bay-B (Standard), Bay-EV (EV), Bay-Align (Alignment)
# Times are plain local times on one clock, with no offset (ADR-0002 #25).
#
# @date must be a future Tuesday within the 90-day booking horizon. 2026-11-10 is a Tuesday.
# The results below hold only on a fresh database: the volume keeps bookings between runs, so run
# docker compose down -v before replaying the script.

@baseUrl = http://localhost:8080
@date = 2026-11-10
# The Saturday after @date; move it with @date.
@saturday = 2026-11-14
@dealershipId = dea10000-0002-0000-0000-000000000001
@unknownDealershipId = dea10000-0002-0000-0000-0000000000ff

@oilChange = 5e7c0000-0000-0000-0000-000000000001
@evBatteryCheck = 5e7c0000-0002-0000-0000-000000000001
@wheelAlignment = 5e7c0000-0002-0000-0000-000000000002

# Vehicle 1: Emma Clarke's Ford Focus
@customer1 = c0570000-0002-0000-0000-000000000001
@vehicle1 = ca700000-0002-0000-0000-000000000001
# Vehicle 2: Liam Patel's Toyota Corolla
@customer2 = c0570000-0002-0000-0000-000000000002
@vehicle2 = ca700000-0002-0000-0000-000000000002
# Vehicle 3 and the electric Nissan Leaf: both Sofia Rossi's
@customer3 = c0570000-0002-0000-0000-000000000003
@vehicle3 = ca700000-0002-0000-0000-000000000003
@electricVehicle = ca700000-0002-0000-0000-000000000004

### 1. Vehicle 1, oil change at 09:00 -> 201, Ben + Bay-A
# Best fit: the technician with the fewest skills and the least specialised bay.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer1}}",
  "vehicleId": "{{vehicle1}}",
  "serviceTypeId": "{{oilChange}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T09:00:00"
}

### 2. Vehicle 2, oil change at 09:00 -> 201, Chloe + Bay-B
# Ben and Bay-A are taken, so the next free technician and Standard bay are used.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer2}}",
  "vehicleId": "{{vehicle2}}",
  "serviceTypeId": "{{oilChange}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T09:00:00"
}

### 3. Vehicle 3, oil change at 09:00 -> 409 NoQualifiedTechnicianAvailable
# Bays are still free, but Ben and Chloe are busy and Dan's shift starts at 12:00.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer3}}",
  "vehicleId": "{{vehicle3}}",
  "serviceTypeId": "{{oilChange}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T09:00:00"
}

### 4. Electric vehicle, EV battery check at 09:00 -> 409 NoQualifiedTechnicianAvailable
# Chloe, the only EV technician, is on the oil change from request 2.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer3}}",
  "vehicleId": "{{electricVehicle}}",
  "serviceTypeId": "{{evBatteryCheck}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T09:00:00"
}

### 5. Electric vehicle, EV battery check at 10:00 -> 201, Chloe + Bay-EV
# Back to back with her 09:00-10:00 job; the EV job needs the EV bay.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer3}}",
  "vehicleId": "{{electricVehicle}}",
  "serviceTypeId": "{{evBatteryCheck}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T10:00:00"
}

### 6a. Vehicle 3, wheel alignment at 09:00 -> 409 NoQualifiedTechnicianAvailable
# Dan is the only Alignment technician, and his shift has not started.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer3}}",
  "vehicleId": "{{vehicle3}}",
  "serviceTypeId": "{{wheelAlignment}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T09:00:00"
}

### 6b. Vehicle 3, wheel alignment at 13:00 -> 201, Dan + Bay-Align
# Inside Dan's shift, on the Alignment bay.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer3}}",
  "vehicleId": "{{vehicle3}}",
  "serviceTypeId": "{{wheelAlignment}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{date}}T13:00:00"
}

### 7. Vehicle 1, oil change on Saturday -> 422 OutsideOpeningHours
# Northgate has no opening hours on Saturday, so it is closed.
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer1}}",
  "vehicleId": "{{vehicle1}}",
  "serviceTypeId": "{{oilChange}}",
  "dealershipId": "{{dealershipId}}",
  "requestedStart": "{{saturday}}T09:00:00"
}

### 8. A dealership that does not exist -> 404 NotFound
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "customerId": "{{customer1}}",
  "vehicleId": "{{vehicle1}}",
  "serviceTypeId": "{{oilChange}}",
  "dealershipId": "{{unknownDealershipId}}",
  "requestedStart": "{{date}}T11:00:00"
}
